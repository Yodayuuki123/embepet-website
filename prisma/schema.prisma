generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- 站点配置 ----------

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------- 用户与账户 ----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("CUSTOMER") // CUSTOMER | ADMIN | STAFF
  createdAt    DateTime  @default(now())
  orders       Order[]
  reviews      Review[]
  addresses    Address[]
  wishlist     WishlistItem[]
  carts        Cart[]
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  country   String  @default("US")
  phone     String?
  isDefault Boolean @default(false)
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------- 商品 ----------

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  tagline     String?
  description String?
  translations String   @default("{}") // JSON {es:{name,tagline},fr:{...},de:{...},ja:{...}}
  kind        String    @default("concern") // concern | species | general
  colorKey    String    @default("forest")
  icon        String?
  sortOrder   Int       @default(0)
  seoTitle    String?
  seoDescription String?
  products    ProductCollection[]
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  subtitle       String
  answerCapsule  String   // GEO: 40-60 词直接答案
  description    String   // markdown
  species        String   @default("dog") // dog | cat | dog_cat
  format         String   @default("chew") // chew | powder | oil | paste | dropper
  colorKey       String   @default("forest")
  badges         String   @default("") // csv: bestseller,new,vet-formulated
  benefits       String   @default("[]") // JSON [{title, body, icon}]
  ingredients    String   @default("[]") // JSON [{name, amount, purpose}]
  feedingGuide   String   @default("[]") // JSON [{weight, amount}]
  faqs           String   @default("[]") // JSON [{q, a}]
  images         String   @default("[]") // JSON [url] 真实图片到位后填充
  translations   String   @default("{}") // JSON {es:{name,subtitle,answerCapsule,benefits:[..]},...}
  featured       Boolean  @default(false)
  bestSeller     Boolean  @default(false)
  status         String   @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  ratingAvg      Float    @default(0)
  ratingCount    Int      @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  variants       Variant[]
  reviews        Review[]
  collections    ProductCollection[]
  wishlistedBy   WishlistItem[]
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Variant {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String // e.g. "90 chews"
  sku            String  @unique
  priceCents     Int
  compareAtCents Int?
  stock          Int     @default(100)
  isDefault      Boolean @default(false)
  sortOrder      Int     @default(0)
  cartItems      CartItem[]
  orderItems     OrderItem[]
}

// ---------- 购物车与订单 ----------

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int     @default(1)

  @@unique([cartId, variantId])
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  status          String      @default("PENDING") // PENDING | PAID | FULFILLED | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  subtotalCents   Int
  discountCents   Int         @default(0)
  shippingCents   Int         @default(0)
  totalCents      Int
  couponCode      String?
  stripeSessionId String?
  paymentMethod   String      @default("stripe") // stripe | dev_mock
  shippingAddress String      @default("{}") // JSON
  trackingNumber  String?
  carrier         String?
  adminNotes      String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productSlug String
  productName String
  variantName String
  colorKey    String   @default("forest")
  format      String   @default("chew")
  unitCents   Int
  qty         Int
}

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  kind             String    @default("percent") // percent | fixed
  value            Int // percent: 10 => 10%; fixed: 分
  active           Boolean   @default(true)
  minSubtotalCents Int       @default(0)
  maxUses          Int?
  usedCount        Int       @default(0)
  endsAt           DateTime?
  createdAt        DateTime  @default(now())
}

// ---------- 评价 ----------

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  petName    String?
  rating     Int
  title      String
  body       String
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ---------- B2B 询盘 ----------

model Inquiry {
  id          String   @id @default(cuid())
  type        String   @default("wholesale") // wholesale | private_label | distributor | other
  company     String
  contactName String
  email       String
  phone       String?
  country     String?
  website     String?
  volume      String?
  message     String
  status      String   @default("NEW") // NEW | IN_PROGRESS | QUOTED | WON | LOST
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- 内容 / 博客 ----------

model Post {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String
  answerCapsule  String    @default("")
  content        String // markdown
  category       String    @default("guides") // guides | nutrition | behavior | news
  tags           String    @default("")
  species        String    @default("dog")
  authorName     String    @default("EMBEPET Science Team")
  authorTitle    String    @default("")
  authorBio      String    @default("")
  reviewedBy     String    @default("") // 兽医审校署名（E-E-A-T）
  pillar         Boolean   @default(false)
  published      Boolean   @default(true)
  publishedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  readMinutes    Int       @default(5)
  faqs           String    @default("[]") // JSON [{q,a}] -> FAQPage schema
  sources        String    @default("[]") // JSON [{label, url}] GEO 引用来源
  coverColorKey  String    @default("forest")
  translations   String    @default("{}") // JSON {es:{title,excerpt},...}
  seoTitle       String?
  seoDescription String?
}

// ---------- 营销 ----------

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  createdAt DateTime @default(now())
}

model Redirect {
  id        String  @id @default(cuid())
  fromPath  String  @unique
  toPath    String
  permanent Boolean @default(true)
}
